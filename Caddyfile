# ============================================
# Caddy Reverse Proxy — Automatic HTTPS
# ============================================
# Caddy auto-provisions Let's Encrypt certificates.
# Add more sites below by duplicating a block with a different domain.

# Bot file hosting
{$ORIGIN_DOMAIN} {
    reverse_proxy bot:{$HOST_PORT}
}

