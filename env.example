# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here

# API Configuration (Optional - for Bale or custom servers)
API_BASE_URL=
API_BASE_FILE_URL=

# Host Configuration for Direct Links
HOST_BASE_URL=http://your-server-ip:8080
HOST_PORT=8080

# File Storage
STORE_TIME_HOURS=48
MAX_TELEGRAM_SIZE_MB=50

# Download Method (aria2 or direct)
DOWNLOAD_METHOD=aria2
ARIA2_RPC_URL=http://localhost:6800/jsonrpc
ARIA2_SECRET=

# Access Control (comma-separated IDs)
WHITELIST=
ADMIN_IDS=