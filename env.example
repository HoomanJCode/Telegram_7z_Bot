# ============================================
# FileBot Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ============================================

# Telegram Bot Token (Required)
# Get it from @BotFather: https://t.me/BotFather
BOT_TOKEN=your_bot_token_here

# Custom API Base URL (Optional)
# For Bale messenger: https://tapi.bale.ai/bot
# Leave empty for official Telegram API
API_BASE_URL=

# Custom File API URL (Optional)
# For Bale messenger: https://tapi.bale.ai/file
# Leave empty for official Telegram API
API_BASE_FILE_URL=

# Direct Link Host Configuration (Optional)
# Set your VPS IP or domain for direct file links
# Example: http://123.456.789.0:8080
HOST_BASE_URL=

# Web Server Port
HOST_PORT=8080

# File Storage Time in Hours
# Default: 48 hours (2 days)
STORE_TIME_HOURS=48

# Maximum File Size for Telegram Upload in MB
# Telegram limit is 50MB for bots
MAX_TELEGRAM_SIZE_MB=50

# Download Method
# Options: aria2 (faster) or direct
DOWNLOAD_METHOD=aria2

# Aria2 RPC Configuration (only if using aria2)
ARIA2_RPC_URL=http://localhost:6800/jsonrpc
ARIA2_SECRET=

# Access Control (Optional)
# Comma-separated user IDs
# Example: 123456789,987654321
WHITELIST=

# Admin User IDs (Optional)
# Comma-separated admin IDs
# Example: 123456789
ADMIN_IDS=